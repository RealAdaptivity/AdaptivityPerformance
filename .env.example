# Adaptivity Performance - Environment Configuration

# Payments are taken in person with a Square terminal. The website integrates
# no payment processor, so there is no publishable key, secret key or webhook
# signing secret to configure here.

# Supabase (AdaptivityPerformance project — shared by web, customer app, tech app)
VITE_SUPABASE_URL=https://qqyairzymqpkbfxobztx.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-key
# Optional: deploy edge functions from repo (Dashboard → Account → Access Tokens)
# SUPABASE_ACCESS_TOKEN=sbp_...

# Supabase Edge Function secrets (Dashboard → Edge Functions → Secrets):
# ADAPTIVITY_SITE_URL=https://realadaptivity.github.io/AdaptivityPerformance
# ADAPTIVITY_SUPPORT_EMAIL=hello@adaptivityperformance.com
# ADMIN_BOOTSTRAP_SECRET          # shared secret for the bootstrap-admin function
# TEAMS_WEBHOOK_URL               # Incoming Webhook for notify-teams-new-booking

# Optional (Twilio auto-SMS) — billed per message, so leave unset until volume
# justifies it. Techs use the device Messages composer for on-the-way texts today.
# TWILIO_ACCOUNT_SID=ACxxxxxxxx
# TWILIO_AUTH_TOKEN=...
# TWILIO_FROM_NUMBER=+1xxxxxxxxxx
