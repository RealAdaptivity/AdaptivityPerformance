# Adaptivity Performance - Environment Configuration

# Stripe — publishable key on website; secret key ONLY in Supabase Edge Function secrets
# Keep pk_/sk_ modes matched (both test or both live). Customer app: EXPO_PUBLIC_STRIPE_PUBLISHABLE_KEY.
VITE_STRIPE_PUBLISHABLE_KEY=pk_test_...
STRIPE_SECRET_KEY=sk_test_...   # local scripts only — do NOT commit; also set in Supabase secrets
VITE_STRIPE_CONNECT_CLIENT_ID=ca_...
# Optional override (edge validates against key prefix): STRIPE_MODE=test|live

# Supabase Edge Function secrets (Dashboard → Edge Functions → Secrets):
# STRIPE_SECRET_KEY
# STRIPE_WEBHOOK_SECRET          # REQUIRED when using sk_live_ (webhook fails closed without it)
# ADAPTIVITY_SITE_URL
# STRIPE_INSTANT_PAYOUTS_ENABLED=true   # webhook auto instant payout after each job payment
# ADAPTIVITY_SITE_URL=https://realadaptivity.github.io/AdaptivityPerformance  # Stripe Connect return URLs for tech app
# ADAPTIVITY_SUPPORT_EMAIL=hello@adaptivityperformance.com
# ADAPTIVITY_STRIPE_BRAND_LOGO_URL=https://.../your-logo.png   # PNG/JPG for Stripe onboarding sidebar
# ADAPTIVITY_STRIPE_BRAND_ICON_URL=https://.../your-icon.png

# --- Live Stripe go-live checklist ---
# 1) Stripe Dashboard → switch to Live → copy pk_live_ / sk_live_
# 2) Set VITE_STRIPE_PUBLISHABLE_KEY (web) + EXPO_PUBLIC_STRIPE_PUBLISHABLE_KEY (apps) to pk_live_
# 3) Supabase secrets: STRIPE_SECRET_KEY=sk_live_... + STRIPE_WEBHOOK_SECRET from Live webhook endpoint
# 4) Create TWO webhook endpoints (Test + Live) → https://qqyairzymqpkbfxobztx.supabase.co/functions/v1/stripe-webhook
#    Events: payment_intent.*, charge.refunded, payout.paid, payout.failed, account.updated
# 5) Connect → Settings → Payouts → Allow debit cards = Yes (Live dashboard)
# 6) Redeploy edge functions (scripts/deploy-stripe-functions.ps1 or package + remote deploy)
# 7) Dry-run: small real booking → capture → Standard cash-out → Instant with debit

# Supabase (AdaptivityPerformance project — shared by web, customer app, tech app)
VITE_SUPABASE_URL=https://qqyairzymqpkbfxobztx.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-key
# Optional: deploy edge functions from repo (Dashboard → Account → Access Tokens)
# SUPABASE_ACCESS_TOKEN=sbp_...
